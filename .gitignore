# Comments start with a hash symbol
# Blank lines are ignored and used for readability

# Ignore a specific file
.env

# Ignore an entire directory (trailing slash)
node_modules/
dist/

# Wildcards (*) match any characters except a slash
*.log
*.tmp

# Double asterisks (**) match nested directories recursively
**/temp/

# Negation (!) re-includes a specific file otherwise ignored
!important.log
